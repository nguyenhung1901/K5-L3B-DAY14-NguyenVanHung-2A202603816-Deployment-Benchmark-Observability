# No credentials, local settings or repository history in the build context.
.env
.env.*
!.env.example
.git/
.gitignore
*.pem
*.key
*.log

# Python caches and virtual environments.
__pycache__/
**/__pycache__/
*.py[cod]
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Non-runtime artifacts and performance test reports.
benchmark-observability/
check_production_ready.py
screenshots/
reports/
*.patch
*.md
